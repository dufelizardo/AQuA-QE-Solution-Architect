    <diagram id="elaboracao" name="3 - Elaboracao sequencial do Solution Design">
        <mxGraphModel dx="597" dy="485" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="690" math="0" shadow="0">
            <root>
