                <mxCell id="e_n1" value="extract_solution_context&#xa;(titulo + contexto)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
