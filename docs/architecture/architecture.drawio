                    <mxGeometry x="460" y="140" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_b1" value="GR-SA-1: padrao fora do&#xa;catalogo -&gt; campo fica &quot;&quot;" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="145" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_n3" value="identify_components_and_integrations&#xa;(componentes por camada do padrao + integracoes citadas)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="240" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_b2" value="GR-SA-2: integracao sem&#xa;evidencia textual -&gt; lista vazia" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="245" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_n4" value="identify_candidate_integrations&#xa;(sugestao de integracoes tipicas do dominio, rotulada como sugestao)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="240" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_n5" value="identify_domain_model +&#xa;identify_process_flows&#xa;(entidades e fluxos, so se evidenciados)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="340" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e_n6" value="generate_non_functional_requirements +&#xa;identify_technical_risks&#xa;(NFR categorizado ISO/IEC 25010 + riscos)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="450" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e_n7" value="generate_architecture_decisions&#xa;(ADRs com alternativas e trade-offs)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="560" width="300" height="60" as="geometry"/>
