# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env   (ou: Copy-Item .env.example .env no PowerShell)

# Ollama (local) — obrigatório enquanto LLM_PROVIDER=ollama (padrão)
# Instale o Ollama (https://ollama.com) e baixe os modelos usados por este agente:
#   ollama pull mistral   # geração (OLLAMA_MODEL)
#   ollama pull phi4      # revisão independente (OLLAMA_REVIEW_MODEL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_REVIEW_MODEL=phi4

# Provedor de LLM ativo: "ollama" (padrão, modelos locais), "nvidia" (NVIDIA NIM,
# build.nvidia.com), "cerebras" (Cerebras Inference, api.cerebras.ai — inferência mais
# rápida/estável, gpt-oss-120b em status "Production" lá) ou "google" (Google AI Studio,
# aistudio.google.com, via camada de compatibilidade OpenAI). Todos os provedores em
# nuvem usam API compatível com OpenAI. Piloto opcional — não altera o comportamento
# padrão se deixado comentado/ausente.
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
# NVIDIA_REVIEW_MODEL=meta/llama-3.3-70b-instruct

# LLM_PROVIDER=cerebras
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_REVIEW_MODEL=zai-glm-4.7

# LLM_PROVIDER=google
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-3.1-flash-lite
# GOOGLE_REVIEW_MODEL=gemini-2.5-flash-lite
# gemini-3.5-flash: testado, mas quota do tier gratuito e so 20 req/dia (esgota rapido).
# Outros fallbacks conhecidos, ainda nao testados: gemma-4-26b, gemma-4-31b

# Jira Cloud — obrigatório apenas para usar --jira
# Token gerado em id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://seu-site.atlassian.net/
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence Cloud — obrigatório apenas para usar --confluence
# Usa as mesmas credenciais do Jira (JIRA_EMAIL / JIRA_API_TOKEN) acima.
